# ── VLM provider ──────────────────────────────────────────────────
# Selects which vision-language model receives clothing-tag images.
# Provider and model are read at server start; restart to switch.
# VLM_PROVIDER=google              # google | openai (default: google)
# VLM_MODEL=gemini-2.5-pro         # provider-specific id; see README

# ── Google Gemini ─────────────────────────────────────────────────
# Required when VLM_PROVIDER=google.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-key-here

# ── OpenAI ────────────────────────────────────────────────────────
# Required when VLM_PROVIDER=openai.
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-key-here

# ── Server ────────────────────────────────────────────────────────
# PORT=3001                      # default: 3001

# ── Mock mode (skip VLM calls entirely) ───────────────────────────
# MOCK_OCR=false                 # set to "1" or "true" to use mock tag extraction

# ── Cache ─────────────────────────────────────────────────────────
# CACHE_ENABLED=true
# CACHE_DB_PATH=./cache/ecotag-cache.sqlite
# CACHE_MODE=tiered              # exact | semantic | tiered
# CACHE_SIMILARITY_THRESHOLD=0.9
# CACHE_MAX_ENTRIES=5000
# CACHE_SEMANTIC_EMBEDDER=clip   # clip | fingerprint
# CACHE_SEMANTIC_CLIP_MODEL=Xenova/clip-vit-base-patch32
# CACHE_SEMANTIC_FALLBACK=none   # none | fingerprint
